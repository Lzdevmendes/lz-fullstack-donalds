{
  "name": "pedefree",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n store,admin -c blue,magenta \"npm run dev --workspace=apps/store\" \"npm run dev --workspace=apps/admin\"",
    "dev:store": "npm run dev --workspace=apps/store",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces",
    "build:store": "npm run build --workspace=apps/store",
    "build:admin": "npm run build --workspace=apps/admin",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "prisma:seed:gamboa": "ts-node ./prisma/seed-gamboa.ts"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "prisma": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
